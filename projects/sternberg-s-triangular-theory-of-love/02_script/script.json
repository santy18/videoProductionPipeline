{
  "title": "Every Kind of Love Is a Mix of 3 Ingredients",
  "scenes": [
    {
      "id": "s01",
      "type": "title",
      "narration": "Every kind of love is a mix of just three ingredients.",
      "on_screen": {
        "title": "Love's 3 Ingredients",
        "subtitle": "Sternberg's triangle"
      }
    },
    {
      "id": "s02",
      "type": "bullets",
      "narration": "In nineteen eighty-six, psychologist Robert Sternberg named them: intimacy, passion, and commitment.",
      "on_screen": {
        "heading": "The Triangle",
        "items": [
          "Intimacy: closeness",
          "Passion: attraction",
          "Commitment: the decision"
        ]
      }
    },
    {
      "id": "s03",
      "type": "kinetic",
      "narration": "Mix any two of them, and you get a different kind of love.",
      "on_screen": {
        "text": "Mix any *two*. Get a different *love*."
      }
    },
    {
      "id": "s04",
      "type": "bullets",
      "narration": "Intimacy plus passion is romantic love. Intimacy plus commitment is companionate. Passion plus commitment? Fatuous.",
      "on_screen": {
        "heading": "Two ingredients",
        "items": [
          "Intimacy + Passion = Romantic",
          "Intimacy + Commitment = Companionate",
          "Passion + Commitment = Fatuous"
        ]
      }
    },
    {
      "id": "s05",
      "type": "kinetic",
      "narration": "Companionate love is the deep friendship of a long marriage: close and committed, but the spark has faded.",
      "on_screen": {
        "text": "Close. Committed. The *spark* faded."
      }
    },
    {
      "id": "s06",
      "type": "kinetic",
      "narration": "Fatuous love has passion and commitment, but no intimacy underneath.",
      "on_screen": {
        "text": "Passion and commitment, *no* *intimacy*"
      }
    },
    {
      "id": "s07",
      "type": "stat",
      "narration": "Consummate love has all three. The complete kind.",
      "on_screen": {
        "value": 3,
        "suffix": " of 3",
        "label": "consummate love"
      }
    },
    {
      "id": "s08",
      "type": "outro",
      "narration": "So which ingredient is missing from yours? Follow for more.",
      "on_screen": {
        "text": "Which one is missing?",
        "cta": "Follow for more"
      }
    }
  ]
}